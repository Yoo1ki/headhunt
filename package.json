{
  "name": "headhunt",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --host 0.0.0.0",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "generate:content": "tsx scripts/generate-content-data.ts",
    "generate:banner": "tsx scripts/generate-banner-data.ts",
    "get:pool": "tsx scripts/get-game-pool-data.ts",
    "get:guide": "tsx scripts/get-skport-guide-data.ts",
    "get:wiki-catalog": "tsx scripts/get-skport-wiki-catalog.ts",
    "get:wiki-detail": "tsx scripts/get-skport-wiki-detail.ts",
    "test:wiki-detail": "tsx scripts/test-skport-wiki-detail.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.1",
    "clsx": "^2.1.1",
    "lz-string": "^1.5.0",
    "next": "^15.5.15",
    "next-intl": "^4.8.3",
    "next-pwa": "^5.6.0",
    "react": "19.1.5",
    "react-dom": "19.1.5",
    "react-icons": "^5.6.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.39",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9",
    "eslint-config-next": "15.4.6",
    "puppeteer-core": "^24.40.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5.7.4",
    "wrangler": "^4.84.1"
  }
}
